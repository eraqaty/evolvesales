# EvolveSales docker-socket-proxy rules (§9). Replaces the image's default template, whose
# CONTAINERS switch would also allow exec, archive (file copy), export and update on ANY
# container. The Orchestrator's DockerLauncher needs only the calls below; everything else
# is refused with 403.
#
# Note: a proxy can't inspect request bodies, so "create" is still powerful. The real
# guarantee is that only the Orchestrator can reach this port (bound to 127.0.0.1).

global
    log stdout format raw daemon "${LOG_LEVEL}"
    pidfile /run/haproxy.pid
    maxconn 200

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option http-server-close
    timeout http-request 10s
    timeout connect 10s
    # Long enough for an agent job: POST /containers/{id}/wait blocks until the runner exits.
    timeout client 2h
    timeout server 2h
    timeout tunnel 2h
    maxconn 100

    errorfile 400 /usr/local/etc/haproxy/errors/400.http
    errorfile 403 /usr/local/etc/haproxy/errors/403.http
    errorfile 408 /usr/local/etc/haproxy/errors/408.http
    errorfile 500 /usr/local/etc/haproxy/errors/500.http
    errorfile 502 /usr/local/etc/haproxy/errors/502.http
    errorfile 503 /usr/local/etc/haproxy/errors/503.http
    errorfile 504 /usr/local/etc/haproxy/errors/504.http

backend dockerbackend
    server dockersocket $SOCKET_PATH

frontend dockerfrontend
    bind ${BIND_CONFIG}

    # Health and version negotiation
    http-request allow if METH_GET { path,url_dec -m reg -i ^(/v[\d.]+)?/(_ping|version)$ }
    # Inspect the runner image (names may contain / : @)
    http-request allow if METH_GET { path,url_dec -m reg -i ^(/v[\d.]+)?/images/[a-z0-9._/:@-]+/json$ }
    # List (reaper) and inspect containers
    http-request allow if METH_GET { path,url_dec -m reg -i ^(/v[\d.]+)?/containers/json$ }
    http-request allow if METH_GET { path,url_dec -m reg -i ^(/v[\d.]+)?/containers/[a-z0-9]+/json$ }
    # Create, attach (stdin/stdout), start, wait, kill, remove
    http-request allow if METH_POST { path,url_dec -m reg -i ^(/v[\d.]+)?/containers/create$ }
    http-request allow if METH_POST { path,url_dec -m reg -i ^(/v[\d.]+)?/containers/[a-z0-9]+/(attach|start|wait|kill)$ }
    http-request allow if METH_DELETE { path,url_dec -m reg -i ^(/v[\d.]+)?/containers/[a-z0-9]+$ }

    http-request deny
    default_backend dockerbackend
