{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "vitest"],
  "env": {
    "node": true,
    "browser": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }],
    "import/no-unassigned-import": [
      "warn",
      { "allow": ["**/*.css", "@testing-library/jest-dom/vitest", "reflect-metadata"] }
    ],
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.e2e-spec.ts", "**/*.test.tsx", "**/test/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "**.expect"] }],
        "typescript/no-non-null-assertion": "off"
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "**/node_modules/**", "**/generated/**"]
}
