# Copy to .env (git-ignored) and fill in values. Never commit .env — this repository is public.

# ---- App ----
NODE_ENV=development
APP_VERSION=dev
API_PORT=3000
ORCHESTRATOR_PORT=3001

# ---- PostgreSQL (local Docker, see deploy/compose.dev.yml) ----
POSTGRES_DB=evolvesales
POSTGRES_USER=evolvesales
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://evolvesales:change-me-local-only@localhost:5432/evolvesales

# ---- Auth (Phase 1) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
WEB_ORIGIN=http://localhost:5173
# false only for local http; must be true anywhere served over https
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15

# ---- Demo seed (dev/staging only — never production) ----
# Password shared by the seeded demo users (sales@, manager@, approver@, release@, admin@evolvesales.local)
SEED_USER_PASSWORD=choose-a-local-demo-password

# ---- Added in later phases (listed so the full surface is visible) ----
# Phase 2: LLM_PROVIDER, LLM_MODEL, ANTHROPIC_API_KEY, OPENAI_API_KEY
# Phase 2b: WHATSAPP_ENABLED, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_WABA_ID, WHATSAPP_ACCESS_TOKEN,
#           WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN, WHATSAPP_GRAPH_VERSION, PUBLIC_WEBHOOK_BASE_URL
# Phase 3: GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY_PATH, GITHUB_APP_INSTALLATION_ID, GITHUB_REPOSITORY
