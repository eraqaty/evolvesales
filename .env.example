# Copy to .env (git-ignored) and fill in values. Never commit .env — this repository is public.

# ---- App ----
NODE_ENV=development
APP_VERSION=dev
API_PORT=3000
ORCHESTRATOR_PORT=3001

# ---- PostgreSQL (local Docker, see deploy/compose.dev.yml) ----
POSTGRES_DB=evolvesales
POSTGRES_USER=evolvesales
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://evolvesales:change-me-local-only@localhost:5432/evolvesales

# ---- Auth (Phase 1) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
WEB_ORIGIN=http://localhost:5173
# false only for local http; must be true anywhere served over https
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15

# ---- Demo seed (dev/staging only — never production) ----
# Password shared by the seeded demo users (sales@, manager@, approver@, release@, admin@evolvesales.local)
SEED_USER_PASSWORD=choose-a-local-demo-password

# ---- AI Request Assistant (Phase 2) ----
# Without a key the assistant answers "not configured" (HTTP 503); it never fakes a reply.
# Use a dedicated key with a spend limit.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # only when LLM_PROVIDER=openai (set LLM_MODEL to an OpenAI model)
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
ASSISTANT_MAX_STEPS=5

# ---- WhatsApp channel (Phase 2b) — setup guide: docs/WHATSAPP_SETUP.md ----
# Off by default. When true, the four values marked * are required.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=          # * Meta app → WhatsApp → API Setup → "Phone number ID"
WHATSAPP_WABA_ID=                  #   WhatsApp Business Account ID (for reference)
WHATSAPP_ACCESS_TOKEN=             # * System User token with whatsapp_business_messaging
WHATSAPP_APP_SECRET=               # * Meta app → Settings → Basic → App secret (verifies webhooks)
WHATSAPP_VERIFY_TOKEN=             # * any random string; enter the same value in Meta's webhook form
WHATSAPP_DISPLAY_NUMBER=           #   the bot's number in E.164, e.g. +15551234567 (shown on Profile)
# WHATSAPP_ACTION_SECRET=          #   signs approval buttons; default is derived from JWT_ACCESS_SECRET
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Public address of the web app used in links sent to phones (defaults to WEB_ORIGIN)
# PUBLIC_WEB_URL=https://your-domain.example
# Your ngrok static domain, e.g. evolvesales-dev.ngrok-free.app (tunnel command: docs/WHATSAPP_SETUP.md)
NGROK_DOMAIN=

# ---- Repository analysis (Phase 3), read by the Orchestrator — guide: docs/GITHUB_APP_SETUP.md ----
# GitHub App: the numeric App ID and the PATH of its private key. Keep the .pem outside the
# repository (e.g. C:\Users\<you>\.evolvesales\github-app.pem); never paste the key here.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# The installation and repository are discovered by the App; you authorize the repository on the
# web app's Agents page (admin). There is no GITHUB_APP_INSTALLATION_ID / GITHUB_REPOSITORY.
# REPO_SYNC_INTERVAL_MINUTES=30

# The Orchestrator uses ANTHROPIC_API_KEY (above) for the analysis agent.
AGENT_ANALYZE_MODEL=claude-opus-5-5
# AGENT_ANALYZE_MAX_TURNS=40
# AGENT_ANALYZE_TIMEOUT_MINUTES=15
# Runner image (pnpm runner:build). In production it must be pinned: evolvesales/agent-runner@sha256:…
AGENT_RUNNER_IMAGE=evolvesales/agent-runner:local
# Docker through the restricted docker-socket-proxy (pnpm agents:up). Leave empty for the local socket.
AGENT_DOCKER_HOST=tcp://127.0.0.1:2375
# AGENT_NETWORK=evolvesales-agent-net
# AGENT_EGRESS_PROXY_URL=http://egress-proxy:3128
# Hosts the egress proxy lets agent containers reach (comma-separated; empty = the plan's list)
# EGRESS_ALLOWLIST=
# Spend caps have NO defaults: an admin sets them on the Agents page before analysis can run.
