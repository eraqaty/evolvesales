// EvolveSales database schema.
// Rules: additive (expand → contract) migrations only; money is Decimal(18,2); ids are UUIDv7.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity ─────────────────────────────

enum Role {
  SALES_USER
  SALES_MANAGER
  CHANGE_APPROVER
  RELEASE_MANAGER
  ADMIN
}

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  email                 String    @unique
  displayName           String    @map("display_name")
  passwordHash          String    @map("password_hash")
  roles                 Role[]
  isActive              Boolean   @default(true) @map("is_active")
  failedLoginCount      Int       @default(0) @map("failed_login_count")
  lockedUntil           DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// WhatsApp number in E.164 (+201001234567); recognised only once verified (§19.3).
  phoneE164             String?   @unique @map("phone_e164")
  phoneVerifiedAt       DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  /// argon2 hash of the 6-digit WhatsApp approval PIN.
  approvalPinHash       String?   @map("approval_pin_hash")
  pinFailedCount        Int       @default(0) @map("pin_failed_count")
  pinLockedUntil        DateTime? @map("pin_locked_until") @db.Timestamptz(3)
  /// WhatsApp notification preferences per event type (see NotificationPrefs in shared).
  notificationPrefs     Json?     @map("notification_prefs")
  /// Last message received from this user on WhatsApp: opens Meta's 24-hour free-form window.
  whatsappLastInboundAt DateTime? @map("whatsapp_last_inbound_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens     RefreshToken[]
  invoicesCreated   Invoice[]      @relation("InvoiceCreatedBy")
  invoicesUpdated   Invoice[]      @relation("InvoiceUpdatedBy")
  invoicesConfirmed Invoice[]      @relation("InvoiceConfirmedBy")
  invoicesCancelled Invoice[]      @relation("InvoiceCancelledBy")
  auditLogs         AuditLog[]

  changeRequests     ChangeRequest[]     @relation("CrRequester")
  conversations      Conversation[]
  approvalDecisions  ApprovalDecision[]
  statusTransitions  StatusTransition[]
  notifications      Notification[]
  phoneVerifications PhoneVerification[]
  outboundMessages   OutboundMessage[]
  pendingActions     PendingAction[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// All tokens descended from one login share a family; reuse of a rotated token revokes the family.
  familyId     String    @map("family_id") @db.Uuid
  /// SHA-256 of the opaque token. The token itself is never stored.
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ───────────────────────────── Sales ─────────────────────────────

model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  taxNumber String?  @map("tax_number")
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoices Invoice[]

  @@index([name])
  @@map("customers")
}

model Product {
  id        String   @id @default(uuid(7)) @db.Uuid
  sku       String   @unique
  name      String
  unit      String   @default("pcs")
  unitPrice Decimal  @map("unit_price") @db.Decimal(18, 2)
  /// Fraction: 0.1400 = 14 %.
  taxRate   Decimal  @map("tax_rate") @db.Decimal(5, 4)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoiceItems InvoiceItem[]

  @@index([name])
  @@map("products")
}

/// One row per calendar year; incremented with UPDATE … RETURNING inside the invoice transaction.
model InvoiceSequence {
  year      Int @id
  lastValue Int @map("last_value")

  @@map("invoice_sequences")
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model Invoice {
  id                String        @id @default(uuid(7)) @db.Uuid
  number            String        @unique
  customerId        String        @map("customer_id") @db.Uuid
  status            InvoiceStatus @default(DRAFT)
  issueDate         DateTime      @map("issue_date") @db.Date
  dueDate           DateTime?     @map("due_date") @db.Date
  currency          String        @default("EGP") @db.Char(3)
  /// Percentage 0–100.
  headerDiscountPct Decimal       @default(0) @map("header_discount_pct") @db.Decimal(6, 3)
  subtotal          Decimal       @db.Decimal(18, 2)
  discountTotal     Decimal       @map("discount_total") @db.Decimal(18, 2)
  taxableTotal      Decimal       @map("taxable_total") @db.Decimal(18, 2)
  taxTotal          Decimal       @map("tax_total") @db.Decimal(18, 2)
  grandTotal        Decimal       @map("grand_total") @db.Decimal(18, 2)
  notes             String?
  createdById       String        @map("created_by_id") @db.Uuid
  updatedById       String?       @map("updated_by_id") @db.Uuid
  confirmedById     String?       @map("confirmed_by_id") @db.Uuid
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledById     String?       @map("cancelled_by_id") @db.Uuid
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?       @map("cancel_reason")
  /// Optimistic concurrency token; incremented on every change.
  version           Int           @default(0)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer    Customer      @relation(fields: [customerId], references: [id])
  createdBy   User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?         @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id])
  confirmedBy User?         @relation("InvoiceConfirmedBy", fields: [confirmedById], references: [id])
  cancelledBy User?         @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  items       InvoiceItem[]

  @@index([status])
  @@index([customerId])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id                  String  @id @default(uuid(7)) @db.Uuid
  invoiceId           String  @map("invoice_id") @db.Uuid
  lineNo              Int     @map("line_no")
  productId           String  @map("product_id") @db.Uuid
  description         String?
  quantity            Decimal @db.Decimal(18, 3)
  unitPrice           Decimal @map("unit_price") @db.Decimal(18, 2)
  lineDiscountPct     Decimal @default(0) @map("line_discount_pct") @db.Decimal(6, 3)
  /// Copied from the product when the line is saved.
  taxRate             Decimal @map("tax_rate") @db.Decimal(5, 4)
  lineGross           Decimal @map("line_gross") @db.Decimal(18, 2)
  lineDiscount        Decimal @map("line_discount") @db.Decimal(18, 2)
  headerDiscountShare Decimal @map("header_discount_share") @db.Decimal(18, 2)
  taxableAmount       Decimal @map("taxable_amount") @db.Decimal(18, 2)
  taxAmount           Decimal @map("tax_amount") @db.Decimal(18, 2)
  lineTotal           Decimal @map("line_total") @db.Decimal(18, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([invoiceId, lineNo])
  @@index([productId])
  @@map("invoice_items")
}

// ───────────────────────────── Change management ─────────────────────────────

/// Mirrors CrStatus in packages/shared/src/change-request/lifecycle.ts.
enum CrStatus {
  SUBMITTED
  ANALYZING
  AWAITING_APPROVAL
  CLARIFICATION_REQUIRED
  APPROVED
  REJECTED
  CODING
  TESTING
  PULL_REQUEST_CREATED
  REVIEW
  STAGING
  PRODUCTION_APPROVAL
  RELEASED
  FAILED
}

enum CrPriority {
  LOW
  MEDIUM
  HIGH
}

model ChangeRequest {
  id               String     @id @default(uuid(7)) @db.Uuid
  /// CR-0001, from the change_request_key_seq sequence.
  key              String     @unique
  title            String
  requesterId      String     @map("requester_id") @db.Uuid
  screen           String
  screenContext    Json?      @map("screen_context")
  originalRequest  String     @map("original_request")
  /// The validated ChangeRequestProposal the requester submitted.
  structured       Json
  status           CrStatus
  priority         CrPriority @default(MEDIUM)
  /// Questions from the approver (or analysis agent) waiting for the requester's answer.
  pendingQuestions String[]   @default([]) @map("pending_questions")
  baselineSha      String?    @map("baseline_sha")
  branchName       String?    @map("branch_name")
  currentPlanId    String?    @unique @map("current_plan_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  requester     User                 @relation("CrRequester", fields: [requesterId], references: [id])
  currentPlan   ImplementationPlan?  @relation("CrCurrentPlan", fields: [currentPlanId], references: [id])
  plans         ImplementationPlan[] @relation("CrPlans")
  conversations Conversation[]
  decisions     ApprovalDecision[]
  transitions   StatusTransition[]
  jobs          AgentJob[]

  @@index([status])
  @@index([requesterId])
  @@map("change_requests")
}

enum ConversationStatus {
  OPEN
  SUBMITTED
  CLOSED
}

enum Channel {
  WEB
  WHATSAPP
}

model Conversation {
  id                   String             @id @default(uuid(7)) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  changeRequestId      String?            @map("change_request_id") @db.Uuid
  channel              Channel            @default(WEB)
  screen               String
  screenContext        Json?              @map("screen_context")
  status               ConversationStatus @default(OPEN)
  /// Latest validated proposal from the assistant (shown as the summary card).
  proposal             Json?
  /// Latest ask_clarification questions from the assistant.
  pendingClarification Json?              @map("pending_clarification")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                  @relation(fields: [userId], references: [id])
  changeRequest ChangeRequest?        @relation(fields: [changeRequestId], references: [id])
  messages      ConversationMessage[]

  @@index([userId])
  @@index([changeRequestId])
  @@map("conversations")
}

enum MessageRole {
  user
  assistant
  system
}

model ConversationMessage {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  /// Tool calls, token usage, model id.
  metadata       Json?
  /// WhatsApp message id (wamid) for messages that arrived or left through WhatsApp.
  externalId     String?     @unique @map("external_id")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model ImplementationPlan {
  id              String   @id @default(uuid(7)) @db.Uuid
  changeRequestId String   @map("change_request_id") @db.Uuid
  version         Int
  baselineSha     String?  @map("baseline_sha")
  plan            Json
  verifiedCount   Int      @default(0) @map("verified_count")
  assumptionCount Int      @default(0) @map("assumption_count")
  agent           String?
  model           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  changeRequest ChangeRequest      @relation("CrPlans", fields: [changeRequestId], references: [id])
  currentFor    ChangeRequest?     @relation("CrCurrentPlan")
  decisions     ApprovalDecision[]

  @@unique([changeRequestId, version])
  @@map("implementation_plans")
}

enum ApprovalDecisionKind {
  APPROVED
  REJECTED
  CLARIFICATION
}

model ApprovalDecision {
  id              String               @id @default(uuid(7)) @db.Uuid
  changeRequestId String               @map("change_request_id") @db.Uuid
  planId          String?              @map("plan_id") @db.Uuid
  decision        ApprovalDecisionKind
  actorId         String               @map("actor_id") @db.Uuid
  comment         String?
  /// Set when an Admin approved their own request (separation-of-duties override).
  overrideReason  String?              @map("override_reason")
  channel         Channel              @default(WEB)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  changeRequest ChangeRequest       @relation(fields: [changeRequestId], references: [id])
  plan          ImplementationPlan? @relation(fields: [planId], references: [id])
  actor         User                @relation(fields: [actorId], references: [id])

  @@index([changeRequestId])
  @@map("approval_decisions")
}

enum ActorType {
  USER
  SYSTEM
}

/// Append-only lifecycle history (a trigger rejects UPDATE/DELETE).
model StatusTransition {
  id              String    @id @default(uuid(7)) @db.Uuid
  changeRequestId String    @map("change_request_id") @db.Uuid
  from            CrStatus?
  to              CrStatus
  actorType       ActorType @map("actor_type")
  actorId         String?   @map("actor_id") @db.Uuid
  reason          String?
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id])
  actor         User?         @relation(fields: [actorId], references: [id])

  @@index([changeRequestId, createdAt])
  @@map("status_transitions")
}

enum AgentJobType {
  ANALYZE
  CODE
}

enum AgentJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

model AgentJob {
  id              String         @id @default(uuid(7)) @db.Uuid
  changeRequestId String         @map("change_request_id") @db.Uuid
  type            AgentJobType
  status          AgentJobStatus @default(QUEUED)
  /// pg-boss job id that ran this.
  queueJobId      String?        @map("queue_job_id")
  agentKind       String?        @map("agent_kind")
  model           String?
  containerId     String?        @map("container_id")
  imageDigest     String?        @map("image_digest")
  startedAt       DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz(3)
  exitCode        Int?           @map("exit_code")
  inputTokens     Int?           @map("input_tokens")
  outputTokens    Int?           @map("output_tokens")
  costUsd         Decimal?       @map("cost_usd") @db.Decimal(10, 4)
  error           String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id])

  @@index([changeRequestId])
  @@index([status])
  @@map("agent_jobs")
}

model Notification {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  type              String
  title             String
  body              String
  link              String?
  readAt            DateTime? @map("read_at") @db.Timestamptz(3)
  /// Set when the WhatsApp dispatcher claimed this notification (sent, skipped or failed).
  whatsappHandledAt DateTime? @map("whatsapp_handled_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ───────────────────────────── WhatsApp channel (§19) ─────────────────────────────

/// A pending phone link: the user must send "LINK <code>" from phoneE164 before expiresAt.
model PhoneVerification {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  phoneE164  String    @map("phone_e164")
  /// SHA-256 of the 6-digit code.
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneE164])
  @@index([userId])
  @@map("phone_verifications")
}

/// Every webhook message from Meta, stored before processing. The unique wamid makes retries idempotent.
model InboundChannelEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  waMessageId String    @unique @map("wa_message_id")
  fromPhone   String    @map("from_phone")
  type        String
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  error       String?

  @@map("inbound_channel_events")
}

enum OutboundKind {
  TEXT
  INTERACTIVE
  TEMPLATE
}

enum OutboundStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model OutboundMessage {
  id             String         @id @default(uuid(7)) @db.Uuid
  /// wamid returned by the Graph API; delivery statuses are matched on it.
  waMessageId    String?        @unique @map("wa_message_id")
  userId         String?        @map("user_id") @db.Uuid
  toPhone        String         @map("to_phone")
  kind           OutboundKind
  template       String?
  /// Short description of what was sent (no secrets, no full message bodies).
  summary        String
  notificationId String?        @map("notification_id") @db.Uuid
  status         OutboundStatus @default(PENDING)
  error          String?
  sentAt         DateTime?      @map("sent_at") @db.Timestamptz(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  readAt         DateTime?      @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("outbound_messages")
}

enum PendingActionStage {
  /// The approval card was sent; waiting for a button tap.
  CARD
  AWAITING_PIN
  AWAITING_REASON
  AWAITING_QUESTIONS
}

/// One approval card sent on WhatsApp. Its buttons carry an HMAC-signed reference to this row;
/// it can be used once, expires after 24 hours and is refused if the plan version changed.
model PendingAction {
  id              String             @id @default(uuid(7)) @db.Uuid
  nonce           String
  userId          String             @map("user_id") @db.Uuid
  changeRequestId String             @map("change_request_id") @db.Uuid
  planVersion     Int                @map("plan_version")
  /// approve | reject | clarify once a button was tapped.
  action          String?
  stage           PendingActionStage @default(CARD)
  stageExpiresAt  DateTime?          @map("stage_expires_at") @db.Timestamptz(3)
  expiresAt       DateTime           @map("expires_at") @db.Timestamptz(3)
  consumedAt      DateTime?          @map("consumed_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, stage])
  @@map("pending_actions")
}

// ───────────────────────────── Audit ─────────────────────────────

/// Append-only: a database trigger rejects UPDATE and DELETE (see the init migration).
model AuditLog {
  id            BigInt   @id @default(autoincrement())
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  before        Json?
  after         Json?
  ip            String?
  userAgent     String?  @map("user_agent")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
