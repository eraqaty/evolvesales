{
  "name": "@evolvesales/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and client factory",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "seed": "tsx --conditions=source prisma/seed.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@evolvesales/shared": "workspace:*",
    "@types/pg": "^8.23.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  }
}
